# 1. Google Gemini API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Configuration (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Gmail Notification Settings (Optional - leave blank if only using Telegram)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_google_app_password
ALERT_RECIPIENT_EMAIL=your_email@gmail.com
